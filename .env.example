# AI GrowthPilot Environment Configuration
# Copy this file to .env and configure values

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
DATABASE_URL=sqlite:///./growthpilot.db

# Google Gemini API
# Get an API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Demo Mode (if GEMINI_API_KEY is not set or DEMO_MODE=true, realistic simulation data is returned with clear labels)
DEMO_MODE=false
